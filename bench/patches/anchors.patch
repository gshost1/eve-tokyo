+
+// eve-tokyo anchors: a mechanical index of exact identifiers appended to every checkpoint, so
+// paths, error lines and commands survive summary-of-summary rounds verbatim. Idea credited to
+// Nous Research's Hermes compaction eval ("anchor index", SCORECARD-2026-08-15).
+const ANCHOR_INDEX_HEADER = "Exact references (mechanically extracted, newest first):";
+const ANCHOR_INDEX_BUDGET = 6_000;
+const PATH_RE = /(?:[\w.-]+\/)+[\w.-]+\.[A-Za-z]{1,5}\b/g;
+const ERROR_LINE_RE = /^.*(?:Error\b|FAIL\b|\bE_[A-Z]+|\bTS\d{4}\b|exception|panic).*$/gm;
+
+function extractAnchors(text: string): string[] {
+  const found: string[] = [];
+  for (const m of text.matchAll(ERROR_LINE_RE)) found.push(`error: ${m[0].trim().slice(0, 200)}`);
+  for (const m of text.matchAll(PATH_RE)) found.push(`path: ${m[0]}`);
+  return found;
+}
+
+function messageText(message: ModelMessage): string {
+  if (typeof message.content === "string") return message.content;
+  return message.content
+    .map((part) => {
+      if (part.type === "text") return part.text;
+      if (part.type === "tool-call") {
+        const input = part.input as { command?: unknown } | undefined;
+        const command = typeof input?.command === "string" ? `\ncommand: ${input.command}\n` : "";
+        return `${JSON.stringify(part.input ?? "")}${command}`;
+      }
+      if (part.type === "tool-result") {
+        const output = part.output as { type: string; value?: unknown };
+        return typeof output.value === "string" ? output.value : JSON.stringify(output.value ?? "");
+      }
+      return "";
+    })
+    .join("\n")
+    .replace(/\\n/g, "\n");
 }
+
+function withAnchorIndex(summary: string, previousCheckpoint: string | undefined, older: readonly ModelMessage[]): string {
+  const body = summary.split(ANCHOR_INDEX_HEADER)[0]!.trimEnd();
+  const previous = previousCheckpoint?.split(ANCHOR_INDEX_HEADER)[1] ?? "";
+  const previousEntries = previous.split("\n").map((l) => l.replace(/^- /, "").trim()).filter(Boolean);
+  const fresh: string[] = [];
+  for (const message of older) {
+    const text = messageText(message);
+    for (const line of text.split("\n")) {
+      const command = /^command: (.+)$/.exec(line);
+      if (command) fresh.push(`command: ${command[1]!.slice(0, 200)}`);
+    }
+    fresh.push(...extractAnchors(text));
+  }
+  const ordered = [...fresh.reverse(), ...previousEntries];
+  const seen = new Set<string>();
+  const kept: string[] = [];
+  let size = 0;
+  for (const entry of ordered) {
+    if (seen.has(entry)) continue;
+    seen.add(entry);
+    if (size + entry.length + 3 > ANCHOR_INDEX_BUDGET) break;
+    kept.push(entry);
+    size += entry.length + 3;
+  }
+  return kept.length === 0 ? body : `${body}\n\n${ANCHOR_INDEX_HEADER}\n${kept.map((e) => `- ${e}`).join("\n")}`;
+}

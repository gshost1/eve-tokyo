+// eve-tokyo headtail: keep the start and the end of an oversized payload.
+const HEAD_SHARE = 0.6;
+export function headTailSlice(value: string, limit: number): string {
+  if (value.length <= limit) return value;
+  const head = sliceUtf16Safe(value, Math.ceil(limit * HEAD_SHARE));
+  let tailStart = value.length - (limit - head.length);
+  const first = value.charCodeAt(tailStart);
+  if (first >= 0xdc00 && first <= 0xdfff) tailStart += 1;
+  const omitted = tailStart - head.length;
+  return `${head} …[${omitted} chars omitted]… ${value.slice(tailStart)}`;
+}
